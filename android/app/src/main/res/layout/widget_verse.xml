<?xml version="1.0" encoding="utf-8"?>
<!-- الخلفية صورة زجاج سائل مرسومة بحزمة liquid_glass_widgets داخل التطبيق -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✦  رسالة اليوم"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/coptic_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </LinearLayout>

        <TextView
            android:id="@+id/verse_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/verse_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFF3C77A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>
