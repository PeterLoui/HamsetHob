<?xml version="1.0" encoding="utf-8"?>
<!-- ويدجت شاشة القفل: التاريخ القبطي ورسالة اليوم فقط، فوق زجاج الحزمة -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/coptic_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/coptic_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#F2FFFFFF"
                android:textSize="16sp"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </LinearLayout>

        <TextView
            android:id="@+id/verse_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/verse_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFF3C77A"
            android:textSize="11sp"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>
