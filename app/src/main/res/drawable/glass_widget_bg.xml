<?xml version="1.0" encoding="utf-8"?>
<!-- زجاج سائل للويدجت: تظليل + غشاء متدرج + لمعة + حافة مضيئة -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#4D1A0F2E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#52FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#2EFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0"
                android:gradientRadius="260dp"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1.2dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
</layer-list>
